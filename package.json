{
  "name": "grid-electric-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/clean-next-duplicates.ts",
    "dev": "next dev --webpack",
    "dev:fresh": "npm run clean:next && next dev --webpack",
    "prebuild": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/clean-next-duplicates.ts",
    "build": "next build",
    "start": "next start",
    "clean:next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true }); require('node:fs').rmSync('.next-dev', { recursive: true, force: true });\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:offline": "playwright test --grep @offline",
    "test:security": "vitest run src/lib/auth src/lib/validation",
    "test:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:all": "npm run test && npm run test:e2e",
    "provision:users": "node --experimental-strip-types scripts/provision-users-from-csv.ts",
    "upsert:contractor": "node --experimental-strip-types scripts/upsert-single-contractor.ts",
    "schema:utilities": "node scripts/generate-utility-config.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-progress": "^1.1.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.20",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "exifreader": "^4.36.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.563.0",
    "mapbox-gl": "^3.18.1",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "agentation": "^3.0.2",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.0.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
